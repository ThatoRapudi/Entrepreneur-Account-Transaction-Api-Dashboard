# This project runs with zero setup - no .env needed at all, since
# config.py and docker-compose.yml both fall back to working demo
# defaults on their own. Only copy this to .env if actually deploying
# for real: fill in real values below, and never commit that file.

# Database Configuration
# Local SQLite (default, no setup required):
DATABASE_URL=sqlite:///./entrepreneur.db
# Postgres (e.g. via docker-compose, or a managed provider):
# DATABASE_URL=postgresql://entrepreneur_app:CHANGE_ME@localhost:5432/entrepreneur_db
DATABASE_NAME=entrepreneur_db

# JWT Secret - generate your own, never reuse this or any example value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_YOUR_OWN_SECRET

# Dashboard login gate - change both before deploying anywhere shared
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# API Configuration
DEBUG=False
API_TITLE=Entrepreneur Account Aggregation API
API_VERSION=1.0.0

# Deployed frontend origin(s) for CORS - comma-separated if more than
# one (e.g. staging + prod). Leave blank for local dev.
FRONTEND_URL=

# --- Postgres container settings (docker-compose only) ---
# These feed the postgres service in docker-compose.yml; DATABASE_URL
# above should point at the same values (host "db" when running via
# compose, since services reach each other by service name).
POSTGRES_USER=entrepreneur_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=entrepreneur_db

# --- Frontend build-time setting ---
# Where the built frontend should send API requests. Defaults to
# http://localhost:8000 in dev if unset.
VITE_API_BASE_URL=http://localhost:8000
